DRIVER=~none+~httpx+~websockets
# 必填 app_id、app_secret；其余字段可省略
# api_base 默认 https://openapi.seatalk.io
# ws_url 默认 wss://ws-openapi.haiserve.com/ws/bot；自定义时须与 REST 对应同一环境
# reply_mode 默认 thread（群消息开启分支回复），可设为 quote（群聊引用回复）
# 已在分支中的群消息，两种模式均在原分支内引用；私聊不自动引用
# bot_seatalk_id 可选，用于识别机器人自身
SEATALK_BOTS=[{"app_id":"your-app-id","app_secret":"your-app-secret","reply_mode":"thread"}]
